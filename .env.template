# MCP Server Configuration
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_LOG_LEVEL=INFO

# OAuth (for claude.ai custom connectors). Setting MCP_ADMIN_TOKEN turns it on;
# the other two are then required. Leave all three empty to keep sending the
# bot token in the Authorization header instead.
# Generate the admin token with: openssl rand -hex 32
MCP_ADMIN_TOKEN=
MCP_PUBLIC_URL=
DISCORD_BOT_TOKEN=
# Registered OAuth clients and hashed tokens are kept here.
MCP_DATA_DIR=data

# Discord Configuration
DISCORD_MAX_SHARDS=1
DISCORD_SESSION_TIMEOUT=300
DISCORD_RECONNECT_ATTEMPTS=5
DISCORD_RECONNECT_DELAY=1

# Event Streaming
EVENT_STREAM_BUFFER_SIZE=100
EVENT_STREAM_TIMEOUT=30
